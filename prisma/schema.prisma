// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Enums
enum RoleType {
  CANDIDATE
  EMPLOYEE
  ADMIN
}

// Functional role of an EMPLOYEE user within their organization.
// Orthogonal to RoleType (account type); drives endpoint authorization.
enum BusinessRole {
  REGULAR
  DEPARTMENT_ADMIN
  HR
  ORGANIZATION_ADMIN
}

enum GenderType {
  MALE
  FEMALE
  OTHER
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
}

enum EmployeeType {
  FULL_TIME
  PART_TIME
  CONTRACTOR
}

enum WorkLocation {
  ON_SITE
  REMOTE
  HYBRID
}

enum ContractType {
  FULL_TIME
  PART_TIME
  CONTRACT
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  PENDING
}

enum ApplicationStatus {
  APPLIED
  INTERVIEW
  OFFERED
  ACCEPTED
  REJECTED
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum JobStatus {
  OPEN
  CLOSED
}

enum ProjectStatus {
  PLANNED
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
}

// Models

model Organization {
  id          String  @id @default(uuid()) @db.Uuid
  name        String
  slug        String  @unique
  email       String  @unique
  phone       String
  address     String
  country     String
  state       String
  city        String
  zipCode     String
  logoUrl     String?
  websiteUrl  String?
  description String?
  creatorId   String  @unique @db.Uuid
  creator     User    @relation("OrganizationCreator", fields: [creatorId], references: [id])

  // Daily auto check-out time in 24h "HH:MM", interpreted in server local time.
  attendanceCheckOutTime String @default("17:00")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users       User[]                @relation("OrganizationUsers")
  departments Department[]
  holidays    Holiday[]
  projects    Project[]
  jobs        Job[]
  officeBranches OfficeBranch[]
  invitations    EmployeeInvitation[]
}



model User {
  id              String        @id @default(uuid()) @db.Uuid
  email           String        @unique
  password        String
  firstName       String
  lastName        String
  phone           String
  role            RoleType      @default(EMPLOYEE)
  businessRole    BusinessRole?
  isEmailVerified Boolean

  // True only once every step of the user's onboarding flow is finished — for an
  // organization admin that means the whole wizard (organization, branches,
  // invitations), for an employee their personal details. Surfaced as a JWT
  // claim so the frontend can gate routing without an extra request.
  isOnboarded Boolean @default(false)

  // When they finished, for display. Never gate on this — `isOnboarded` is the
  // single source of truth.
  onboardedAt DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  organization        Organization?    @relation("OrganizationUsers", fields: [organizationId], references: [id])
  organizationId      String?          @db.Uuid
  createdOrganization Organization?    @relation("OrganizationCreator")
  employeeProfile     EmployeeProfile?
  employee            Employee?
  candidate           Candidate?
  notifications       Notification[]
  createdProjects     Project[]        @relation("ProjectCreator")
}

// Applications

model CandidateProfile {
  id String @id @default(uuid()) @db.Uuid

  candidateId String    @unique @db.Uuid
  candidate   Candidate @relation(fields: [candidateId], references: [id])

  resumeUrl String?
  skills    String?
}

model Candidate {
  id        String @id @default(uuid()) @db.Uuid
  email     String @unique
  firstName String
  lastName  String

  // Backing account (role CANDIDATE). Promotion flips this user to EMPLOYEE.
  userId String @unique @db.Uuid
  user   User   @relation(fields: [userId], references: [id])

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  isDeleted        Boolean           @default(false)
  deletedAt        DateTime?
  candidateProfile CandidateProfile?
  applications     Application[]
}

// A physical location belonging to an organization. Jobs may optionally be tied
// to one; employees carry an optional branch as well.
model OfficeBranch {
  id             String       @id @default(uuid()) @db.Uuid
  name           String
  address        String
  country        String
  state          String
  city           String
  zipCode        String?
  phone          String?
  email          String?
  isHeadquarters Boolean      @default(false)

  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])

  jobs      Job[]
  employees Employee[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, name])
}

model Job {
  id                      String                @id @default(uuid()) @db.Uuid
  name                    String?
  description             String
  organizationId          String                @db.Uuid
  organization            Organization          @relation(fields: [organizationId], references: [id])
  departmentId            String                @db.Uuid
  department              Department            @relation(fields: [departmentId], references: [id])
  applications            Application[]
  departmentDesignationId String                @db.Uuid
  departmentDesignation   DepartmentDesignation @relation(fields: [departmentDesignationId], references: [id])
  amount                  String
  workLocation            WorkLocation          @default(ON_SITE)
  contractType            ContractType          @default(FULL_TIME)
  contractDuration        String?
  status                  JobStatus             @default(OPEN)

  // Optional: the branch this job is located at.
  officeBranchId String?       @db.Uuid
  officeBranch   OfficeBranch? @relation(fields: [officeBranchId], references: [id])
}

model Application {
  id          String            @id @default(uuid()) @db.Uuid
  jobId       String            @db.Uuid
  job         Job               @relation(fields: [jobId], references: [id])
  candidateId String            @db.Uuid
  candidate   Candidate         @relation(fields: [candidateId], references: [id])
  appliedAt   DateTime          @default(now())
  status      ApplicationStatus @default(APPLIED)
}

// Organization Internals
enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LeaveType {
  ANNUAL
  SICK
  UNPAID
  OTHER
}

enum PayrollStatus {
  PENDING
  PAID
  UNPAID
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  ON_LEAVE
  WEEKEND
}

model Attendance {
  id           String           @id @default(uuid()) @db.Uuid
  employeeId   String           @db.Uuid
  employee     Employee         @relation(fields: [employeeId], references: [id])
  date         DateTime         @default(now())
  checkInTime  DateTime?
  checkOutTime DateTime?
  status       AttendanceStatus @default(ABSENT)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  // One attendance row per employee per day (date normalized to midnight).
  @@unique([employeeId, date])
}

model Department {
  id String @id @default(uuid()) @db.Uuid

  name           String
  description    String?
  location       String?
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])
  jobs           Job[]
  employees      Employee[]

  designations DepartmentDesignation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DepartmentDesignation {
  id           String     @id @default(uuid()) @db.Uuid
  name         String
  departmentId String     @db.Uuid
  department   Department @relation(fields: [departmentId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  jobs      Job[]
  employees Employee[]
}

// The employee's own personal details — everything they fill in themselves during
// onboarding, as opposed to the org-side facts an admin sets on Employee.
model EmployeeProfile {
  id String @id @default(uuid()) @db.Uuid

  userId String @unique @db.Uuid
  user   User   @relation(fields: [userId], references: [id])

  organizationId String @db.Uuid

  dateOfBirth   DateTime?
  gender        GenderType?
  maritalStatus MaritalStatus?

  address String?
  city    String?
  state   String?
  country String?
  zipCode String?

  avatarUrl String?

  emergencyContactName         String?
  emergencyContactPhone        String?
  emergencyContactRelationship String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Employee {
  id String @id @default(uuid()) @db.Uuid

  userId String @unique @db.Uuid
  user   User   @relation(fields: [userId], references: [id])

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organizationId String   @db.Uuid

  // Current placement. These two are the single source of truth for where an
  // employee sits and what they are called — there is no second table recording
  // the same fact. A designation belongs to a department, so the two are always
  // written together.
  departmentId String?     @db.Uuid
  department   Department? @relation(fields: [departmentId], references: [id])

  designationId String?                @db.Uuid
  designation   DepartmentDesignation? @relation(fields: [designationId], references: [id])

  // Monthly gross salary; must be set before payroll can be generated.
  salary Float?

  // Optional: the office branch this employee works out of.
  officeBranchId String?       @db.Uuid
  officeBranch   OfficeBranch? @relation(fields: [officeBranchId], references: [id])

  // Org-side employment facts, set by the admin — never by the employee.
  joiningDate  DateTime?
  employeeType EmployeeType?
  workLocation WorkLocation?

  leaves              Leave[]
  attendances         Attendance[]
  payrolls            Payroll[]
  projects            Project[]            @relation("ProjectCollaborators")
}

// An outstanding invitation to join an organization. No User row exists until the
// invite is accepted, so there are no half-provisioned accounts.
model EmployeeInvitation {
  id    String @id @default(uuid()) @db.Uuid
  email String

  // SHA-256 of the invite token. The raw value only ever exists in the emailed
  // link, so a database leak yields no usable invitations. Nulled on accept or
  // revoke, which is what makes the emailed link stop working.
  tokenHash String? @unique

  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])

  // Admin-set context, copied onto the Employee when the invite is accepted.
  departmentId   String?      @db.Uuid
  designationId  String?      @db.Uuid
  officeBranchId String?      @db.Uuid
  businessRole   BusinessRole @default(REGULAR)

  status         InvitationStatus @default(PENDING)
  invitedById    String           @db.Uuid
  acceptedUserId String?          @db.Uuid
  acceptedAt     DateTime?
  expiresAt      DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, email])
  @@index([organizationId, status])
}

model Leave {
  id          String      @id @default(uuid()) @db.Uuid
  employeeId  String      @db.Uuid
  employee    Employee    @relation(fields: [employeeId], references: [id])
  startDate   DateTime    @default(now())
  endDate     DateTime
  status      LeaveStatus @default(PENDING)
  leaveType   LeaveType   @default(ANNUAL)
  leaveReason String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Payroll {
  id         String        @id @default(uuid()) @db.Uuid
  employeeId String        @db.Uuid
  employee   Employee      @relation(fields: [employeeId], references: [id])
  month      Int
  year       Int
  amount     Float
  status     PayrollStatus @default(PENDING)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  // One payroll row per employee per month.
  @@unique([employeeId, month, year])
}

model Project {
  id         String        @id @default(uuid()) @db.Uuid
  name       String
  startDate  DateTime
  finishDate DateTime?
  status     ProjectStatus @default(PLANNED)
  timeline   String?

  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])

  // The admin (user) who created the project.
  createdById String @db.Uuid
  createdBy   User   @relation("ProjectCreator", fields: [createdById], references: [id])

  // Employees assigned to the project.
  collaborators Employee[] @relation("ProjectCollaborators")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Holiday {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  date           DateTime
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // One holiday per date within an organization.
  @@unique([organizationId, date])
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  title     String?
  message   String
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  read      Boolean  @default(false)
}

model Settings {
  id                          String   @id @default(uuid()) @db.Uuid
  is2FAEnabled                Boolean  @default(false)
  isPushNotificationsEnabled  Boolean  @default(false)
  isEmailNotificationsEnabled Boolean  @default(false)
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt
}
