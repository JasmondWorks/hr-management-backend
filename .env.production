PORT=3000
NODE_ENV=development

# JWT
ACCESS_SECRET=super_secret_access_key_change_me_in_production
REFRESH_SECRET=super_secret_refresh_key_change_me_in_production
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin123
POSTGRES_DB=express_db

# Prisma (for local CLI usage — connecting to the exposed port 5432 on localhost)
DATABASE_URL="postgresql://admin:admin123@localhost:5432/express_db?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
